/* The latch floats over the world as a single instrument. */
.detention-lock {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 7, 7, .54);
}
.detention-lock__plate {
    width: 92%;
    max-width: 430px;
    max-height: 95%;
    padding: 16px 23px 17px;
    align-items: stretch;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(184, 152, 101, .42);
    background-color: rgba(14, 19, 17, .90);
}
.detention-lock__title {
    margin: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 27px;
    letter-spacing: 4px;
    color: #f1e8d3;
}
.detention-lock__help {
    margin: 7px 0 0;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 14px;
    color: #c8beaa;
}
.detention-lock__dial {
    height: 240px;
    min-height: 106px;
    flex-shrink: 1;
    margin: 4px 0 0;
}
.detention-lock__contacts {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    height: 25px;
}
.detention-lock__contact {
    margin: 0 4px;
    min-width: 20px;
    -unity-text-align: middle-center;
    font-size: 19px;
    color: #8c8473;
}
.detention-lock__contact--seated {
    color: #edca8c;
}
.detention-lock__status {
    height: 24px;
    margin: 2px 0 0;
    -unity-text-align: middle-center;
    font-size: 14px;
    color: #f0d09b;
}
.detention-lock__status--miss {
    color: #ef9c89;
}
.detention-lock__actions {
    flex-direction: row;
    align-items: stretch;
    margin-top: 12px;
}
.detention-lock__confirm, .detention-lock__cancel {
    height: 36px;
    margin: 0;
    border-width: 1px;
    border-radius: 0;
    font-size: 15px;
    -unity-text-align: middle-center;
}
.detention-lock__confirm {
    flex-grow: 1;
    color: #f3dab1;
    border-color: #816746;
    background-color: #31291f;
}
.detention-lock__confirm:hover, .detention-lock__confirm:focus,
.detention-lock__confirm--ready {
    color: #1a1710;
    border-color: #f1d19a;
    background-color: #d5ae72;
}
.detention-lock__cancel {
    width: 100px;
    margin-left: 10px;
    color: #c7c3b6;
    border-color: rgba(199, 195, 182, .25);
    background-color: #1b221f;
}
.detention-lock__cancel:hover, .detention-lock__cancel:focus {
    color: #f1e8d3;
    border-color: #8c8473;
    background-color: #333d37;
}

/* Let the player keep sight of the approach while working the generator. */
.field-synchronizer {
    background-color: rgba(0,0,0,0);
    align-items: flex-end;
    justify-content: flex-end;
}
.field-synchronizer .detention-lock__plate {
    margin-right: 8%; margin-bottom: 11%;
    width: 280px; padding: 0;
    align-items: center;
    border-width: 0; background-color: rgba(0,0,0,0);
}
.field-synchronizer .detention-lock__title {
    font-size: 19px; letter-spacing: 2px;
    color: #f2d5a0;
    text-shadow: 0 1px 4px #090908;
}
.field-synchronizer .detention-lock__dial { width: 217px; height: 217px; flex-shrink: 0; }
.field-synchronizer .detention-lock__status {
    position: absolute; left: 0; right: 0; bottom: 22%; margin: 0;
    font-size: 16px; -unity-text-align: middle-center;
}
.field-synchronizer .detention-lock__help { font-size: 16px; margin: 1px 0 0; color: #fff4e0; text-shadow: 0 1px 4px #060604; }
.field-synchronizer .detention-lock__contacts { display: none; }
.field-synchronizer .detention-lock__status {
    position: absolute; top: 63%; left: 0; right: 0; margin: 0;
    font-size: 15px; -unity-font-style: bold;
}
.field-synchronizer .detention-lock__actions { margin-top: 5px; }
.field-synchronizer .detention-lock__confirm, .field-synchronizer .detention-lock__cancel {
    width: auto; height: 32px; padding: 0 10px;
    background-color: rgba(12,15,13,.86); border-width: 0;
    border-bottom-width: 1px; border-bottom-color: #877455;
}
.field-synchronizer .detention-lock__confirm--ready, .field-synchronizer .detention-lock__confirm:hover,
.field-synchronizer .detention-lock__confirm:focus { background-color: #e5c58f; color: #1a1710; }
.field-synchronizer .detention-lock__cancel:hover, .field-synchronizer .detention-lock__cancel:focus { background-color: #574d40; }
.compact .field-synchronizer .detention-lock__plate { margin-right: 2%; margin-bottom: 14%; }
