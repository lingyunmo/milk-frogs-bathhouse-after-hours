
/* After Hours interface, part two: pause, option sheets, backpack, map, repair panels and endings.
   The world keeps rendering behind these screens; the camera grade blurs and darkens it. */

/* ------------------------------------------------------------------ Pause */

.veil {
    transition-property: opacity;
    transition-duration: .25s;
}
.menu-scrim {
    right: 28%;
    background-size: 100% 100%;
}
.pause-veil {
    background-color: rgba(3, 5, 4, .22);
}
.menu-column {
    position: absolute;
    left: 7.2%;
    top: 11%;
    bottom: 7%;
    width: 640px;
    transition-property: opacity, translate;
    transition-duration: .35s;
    transition-timing-function: ease-out;
}
.menu-heading {
    margin: 0;
    font-size: 74px;
    letter-spacing: 16px;
    color: var(--ink-bright);
    text-shadow: 0 4px 22px rgba(0, 0, 0, .85);
}
.menu-rule {
    width: 64px;
    height: 1px;
    margin: 20px 0 26px;
    background-color: var(--brass);
}
.menu-list {
    align-items: flex-start;
}
.menu-notice {
    margin: 16px 0 0 2px;
    font-size: 15px;
    letter-spacing: 1px;
    color: var(--brass-bright);
}
.menu-footer {
    position: absolute;
    right: 5%;
    bottom: 5%;
    flex-direction: row;
}
.pause-brief {
    position: absolute; right: 9%; top: 20%; width: 355px;
    padding: 26px 29px 30px 35px;
    background-color: #cabb9f; background-image: url("TicketWallet.jpg");
    background-size: 100% 100%; rotate: 1deg;
    transition-property: opacity, translate; transition-duration: .32s;
}
.brief-dateline { margin: 0; font-size: 18px; letter-spacing: 3px; color: #574532; }
.brief-rule { height: 1px; margin: 12px 0 24px; background-color: #827056; }
.brief-place { font-size: 16px; color: #66462e; white-space: normal; }
.brief-objective { margin: 5px 0 0; font-size: 29px; color: #2d2c22; white-space: normal; }
.pinned-print {
    align-self: flex-end; margin: 22px 0 2px; padding: 8px 8px 3px;
    width: 210px; rotate: -4deg; background-color: #e3d6bb; border-width: 1px; border-color: #a79778;
    transition-property: rotate, translate; transition-duration: .18s;
}
.pinned-print:hover, .pinned-print:focus { rotate: -1deg; translate: 0 -3px; border-color: #724a22; }
.pinned-image { height: 125px; width: 100%; background-size: cover; }

/* ------------------------------------------------------------------ Sheets: options, controls, confirmations */

.sheet {
    flex-shrink: 1;
    width: 620px;
    max-width: 100%;
    padding: 26px 36px 22px;
    background-color: rgba(6, 8, 7, .82);
    border-width: 1px;
    border-color: var(--hairline);
    border-top-width: 2px;
    border-top-color: var(--brass);
    transition-property: opacity, translate;
    transition-duration: .3s;
    transition-timing-function: ease-out;
}
.sheet-heading {
    margin: 0 0 10px;
    font-size: 34px;
    letter-spacing: 9px;
    color: var(--ink-bright);
}
.sheet-caption {
    margin: 4px 0 6px;
    font-size: 17px;
    color: var(--ink-soft);
    white-space: normal;
}
.sheet-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    max-height: 540px;
}
.sheet-scroll .unity-scroller--vertical {
    width: 6px;
    margin-left: 10px;
}
.sheet-scroll .unity-scroller__low-button, .sheet-scroll .unity-scroller__high-button {
    display: none;
}
.sheet-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    border-width: 0;
    background-color: rgba(236, 229, 211, .06);
}
.sheet-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    border-width: 0;
    border-radius: 3px;
    background-color: var(--brass-soft);
}
.sheet-section {
    margin: 14px 0 2px;
    font-size: 12px;
    letter-spacing: 6px;
    color: var(--brass);
}
.setting-row {
    flex-direction: row;
    align-items: center;
    height: 40px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(236, 229, 211, .07);
}
.setting-name {
    width: 150px;
    margin: 0;
    font-size: 16px;
    color: var(--ink-soft);
}
.setting-slider {
    flex-grow: 1;
    height: 24px;
    margin: 0 18px 0 0;
}
.setting-slider .unity-base-slider__tracker {
    height: 2px;
    margin-top: -1px;
    border-width: 0;
    border-radius: 1px;
    background-color: rgba(236, 229, 211, .18);
}
.setting-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: var(--brass);
}
.setting-slider .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    margin-top: -6px;
    border-width: 2px;
    border-color: rgba(6, 8, 7, .95);
    border-radius: 7px;
    background-color: var(--brass-bright);
    transition-property: scale;
    transition-duration: .12s;
}
.setting-slider:hover .unity-base-slider__dragger, .setting-slider:focus .unity-base-slider__dragger {
    scale: 1.3 1.3;
}
.setting-value {
    width: 58px;
    margin: 0;
    font-size: 15px;
    -unity-text-align: middle-right;
    color: var(--brass-bright);
}
.switch-row {
    height: 40px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(236, 229, 211, .07);
    border-radius: 0;
    font-size: 16px;
    color: var(--ink-soft);
    -unity-text-align: middle-left;
    transition-property: color, background-color;
    transition-duration: .15s;
}
.switch-row:hover, .switch-row:focus {
    color: var(--ink-bright);
    background-color: rgba(202, 164, 107, .06);
}
.switch-track {
    position: absolute;
    right: 4px;
    top: 11px;
    width: 36px;
    height: 18px;
    border-width: 1px;
    border-color: rgba(236, 229, 211, .22);
    border-radius: 9px;
    background-color: rgba(236, 229, 211, .10);
    transition-property: background-color, border-color;
    transition-duration: .18s;
}
.switch-knob {
    position: absolute;
    left: 2px;
    top: 2px;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: rgba(236, 229, 211, .64);
    transition-property: translate, background-color;
    transition-duration: .18s;
    transition-timing-function: ease-out;
}
.switch--on .switch-track {
    border-color: var(--brass);
    background-color: rgba(202, 164, 107, .42);
}
.switch--on .switch-knob {
    translate: 18px 0;
    background-color: var(--brass-bright);
}
.control-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}
.control-row {
    width: 50%;
    height: 44px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(236, 229, 211, .07);
}
.control-keys {
    width: 132px;
    flex-direction: row;
    align-items: center;
}
.control-keys .key {
    margin-right: 4px;
}
.control-description {
    margin: 0;
    font-size: 15px;
    color: var(--ink-soft);
}
.sheet-actions {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 18px;
}
.sheet-action {
    height: 44px;
    min-width: 128px;
    margin: 0 10px 0 0;
    padding: 0 24px;
    font-size: 18px;
    letter-spacing: 5px;
    color: var(--ink-soft);
    background-color: rgba(236, 229, 211, .05);
    border-width: 1px;
    border-color: rgba(236, 229, 211, .22);
    border-radius: 2px;
    -unity-text-align: middle-center;
    transition-property: color, background-color, border-color;
    transition-duration: .15s;
}
.sheet-action:hover, .sheet-action:focus {
    color: #fff6e2;
    border-color: var(--brass);
    background-color: rgba(202, 164, 107, .13);
}
.sheet-action--primary {
    color: #17120b;
    border-color: var(--brass-bright);
    background-color: var(--brass);
}
.sheet-action--primary:hover, .sheet-action--primary:focus {
    color: #0d0a06;
    background-color: var(--brass-bright);
}
.sheet-action:disabled {
    opacity: .42;
}
.chip-button {
    height: 34px;
    margin: 0 0 0 8px;
    padding: 0 15px;
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--ink-soft);
    background-color: rgba(10, 13, 12, .62);
    border-width: 1px;
    border-color: rgba(236, 229, 211, .24);
    border-radius: 3px;
    -unity-text-align: middle-center;
    transition-property: color, background-color, border-color;
    transition-duration: .15s;
}
.chip-button:hover, .chip-button:focus {
    color: var(--ink-bright);
    border-color: var(--brass);
    background-color: rgba(202, 164, 107, .13);
}

/* ------------------------------------------------------------------ Endings */

.ending-veil {
    align-items: center;
    justify-content: center;
}
.ending--caught {
    background-color: rgba(28, 3, 2, .50);
}
.ending--dawn {
    background-color: rgba(10, 9, 6, .36);
}
.ending {
    align-items: center;
}
.ending-overline {
    margin: 0;
    padding-left: 11px;
    font-size: 14px;
    letter-spacing: 11px;
    color: var(--brass);
}
.ending-title {
    margin: 16px 0 0;
    padding-left: 20px;
    font-size: 96px;
    letter-spacing: 20px;
    color: var(--ink-bright);
    text-shadow: 0 6px 32px rgba(0, 0, 0, .95);
}
.ending--caught .ending-title {
    color: #e5664b;
}
.ending-rule {
    width: 92px;
    height: 1px;
    margin: 26px 0 22px;
    background-color: var(--brass-soft);
}
.ending-caption {
    margin: 0;
    font-size: 20px;
    letter-spacing: 3px;
    color: var(--ink-soft);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 1);
}
.ending-actions {
    flex-direction: row;
    margin-top: 48px;
}
.ending-actions .menu-item {
    min-width: 0;
    margin: 0 20px;
    padding: 0 12px;
    -unity-text-align: middle-center;
    border-left-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0);
}
.ending-actions .menu-item:hover, .ending-actions .menu-item:focus {
    padding-left: 12px;
    border-bottom-color: var(--brass);
}

/* ------------------------------------------------------------------ Backpack */

.inventory-veil {
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 6, 5, .40);
}
.inventory-workspace {
    width: 88%;
    max-width: 1480px;
    height: 84%;
    max-height: 800px;
    transition-property: opacity, translate;
    transition-duration: .3s;
    transition-timing-function: ease-out;
}
.inventory-header, .atlas-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hairline);
}
.inventory-heading, .atlas-heading {
    margin: 0;
    font-size: 50px;
    letter-spacing: 13px;
    color: var(--ink-bright);
    text-shadow: 0 4px 18px rgba(0, 0, 0, .8);
}
.inventory-work {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}
.inventory-library {
    width: 50%;
    min-width: 0;
    padding: 18px 28px 10px 0;
}
.inventory-tabs {
    flex-direction: row;
    height: 46px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hairline);
}
.inventory-tab {
    margin: 0 28px 0 0;
    padding: 0 2px;
    font-size: 19px;
    letter-spacing: 5px;
    color: var(--ink-faint);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    transition-property: color, border-bottom-color;
    transition-duration: .15s;
}
.inventory-tab:hover, .inventory-tab:focus {
    color: var(--ink-bright);
}
.inventory-tab--active {
    color: var(--ink-bright);
    border-bottom-color: var(--brass);
}
.inventory-scroll {
    flex-grow: 1;
    min-height: 0;
    margin-top: 18px;
}
.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding-top: 4px;
}
.inventory-item {
    width: 150px;
    height: 170px;
    margin: 0 14px 14px 0;
    padding: 0;
    overflow: hidden;
    background-color: rgba(9, 11, 10, .66);
    border-width: 1px;
    border-color: rgba(236, 229, 211, .12);
    border-radius: 3px;
    transition-property: border-color, background-color, translate;
    transition-duration: .16s;
}
.inventory-item:hover, .inventory-item:focus {
    translate: 0 -3px;
    border-color: rgba(202, 164, 107, .55);
}
.inventory-item--selected {
    border-color: var(--brass);
    background-color: rgba(202, 164, 107, .10);
}
.inventory-item-glow {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 4%;
    bottom: 22%;
    background-size: 100% 100%;
    -unity-background-image-tint-color: rgba(255, 214, 150, 0);
}
.inventory-item--selected .inventory-item-glow {
    -unity-background-image-tint-color: rgba(255, 214, 150, .22);
}
.inventory-item-art {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 14px;
    bottom: 42px;
    background-size: contain;
    background-position: center;
}
.inventory-item-name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 11px;
    margin: 0;
    font-size: 15px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    color: var(--ink-soft);
}
.inventory-item--selected .inventory-item-name {
    color: var(--ink-bright);
}
.inventory-count {
    position: absolute;
    top: 8px;
    right: 10px;
    margin: 0;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--brass-bright);
}
.inventory-empty {
    margin-top: 22px;
}
.inventory-empty-text {
    margin: 0;
    font-size: 22px;
    color: var(--ink-soft);
}
.inventory-empty-hint {
    margin: 8px 0 0;
    font-size: 15px;
    color: var(--ink-faint);
}
.item-inspection {
    width: 50%;
    min-width: 0;
    padding: 12px 0 0 34px;
    border-left-width: 1px;
    border-left-color: var(--hairline);
}
.item-stand {
    flex-grow: 1;
    min-height: 140px;
    max-height: 380px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}
.item-spotlight {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 0;
    bottom: 6%;
    background-size: 100% 100%;
    -unity-background-image-tint-color: rgba(255, 208, 148, .17);
}
.item-preview {
    width: 82%;
    height: 82%;
    background-size: contain;
    background-position: center;
    transition-property: opacity, translate;
    transition-duration: .25s;
}
.item-orbit {
    position: absolute;
    left: 3%;
    right: 3%;
    top: 2%;
    bottom: 26px;
    overflow: hidden;
    transition-property: opacity, translate;
    transition-duration: .25s;
}
.orbit-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    margin: 0;
    font-size: 12px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    color: var(--ink-faint);
}
.item-details {
    padding: 20px 0 6px;
    transition-property: opacity, translate;
    transition-duration: .3s;
}
.item-kind {
    margin: 0;
    font-size: 12px;
    letter-spacing: 7px;
    color: var(--brass);
}
.inspection-title {
    margin: 6px 0 0;
    font-size: 36px;
    letter-spacing: 5px;
    color: var(--ink-bright);
}
.inspection-status {
    margin: 8px 0 0;
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--brass-bright);
}
.inspection-rule {
    width: 48px;
    height: 1px;
    margin: 16px 0;
    background-color: var(--brass-soft);
}
.inspection-copy {
    margin: 0 0 18px;
    font-size: 17px;
    color: var(--ink-soft);
    white-space: normal;
}
.inventory-use {
    align-self: flex-start;
}
.inventory-footer {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: var(--hairline);
}
.inventory-feedback {
    flex-grow: 1;
    margin: 0;
    font-size: 15px;
    color: var(--brass-bright);
}

/* ------------------------------------------------------------------ Map */

.atlas-veil {
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 5, 5, .55);
}
.atlas-card {
    width: 92%;
    max-width: 1500px;
    height: 88%;
    transition-property: opacity, translate;
    transition-duration: .3s;
    transition-timing-function: ease-out;
}
.atlas-body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
    margin-top: 16px;
}
.floor-rail {
    width: 124px;
    margin-right: 18px;
    justify-content: center;
}
.floor-rail-gap {
    height: 20px;
}
.floor-tab {
    height: 48px;
    margin: 0 0 4px;
    padding: 0 0 0 16px;
    font-size: 19px;
    letter-spacing: 5px;
    color: var(--ink-faint);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 2px;
    border-left-color: rgba(236, 229, 211, .12);
    border-radius: 0;
    -unity-text-align: middle-left;
    transition-property: color, border-left-color, background-color, padding-left;
    transition-duration: .15s;
}
.floor-tab:hover, .floor-tab:focus {
    color: var(--ink-bright);
    border-left-color: var(--brass-soft);
}
.floor-tab--here {
    color: var(--ink-soft);
}
.floor-tab--selected {
    padding-left: 22px;
    color: var(--ink-bright);
    border-left-color: var(--brass);
    background-color: rgba(202, 164, 107, .10);
}
.map-drawing {
    flex-grow: 1;
    overflow: hidden;
    background-color: rgba(5, 8, 7, .74);
    border-width: 1px;
    border-color: var(--hairline);
}
.map-dragging {
    border-color: var(--brass-soft);
}
.map-label {
    position: absolute;
    height: 26px;
    margin: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
    color: rgba(236, 229, 211, .78);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 1);
}
.map-label--here {
    color: var(--brass-bright);
    -unity-font-style: bold;
}
.map-ruler {
    position: absolute;
    left: 22px;
    bottom: 20px;
    margin: 0;
    font-size: 12px;
    color: var(--ink-faint);
}
.atlas-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
}
.atlas-legend, .atlas-tools {
    flex-direction: row;
    align-items: center;
}
.legend {
    flex-direction: row;
    align-items: center;
    margin-right: 24px;
}
.legend-swatch {
    width: 16px;
    height: 10px;
    margin-right: 8px;
    border-width: 1px;
}
.legend-swatch--here {
    background-color: rgba(204, 161, 97, .45);
    border-color: var(--brass-bright);
}
.legend-swatch--seen {
    background-color: rgba(153, 173, 161, .16);
    border-color: rgba(212, 204, 181, .86);
}
.legend-swatch--unknown {
    background-color: rgba(13, 18, 17, .5);
    border-color: rgba(122, 140, 133, .45);
}
.legend-text {
    margin: 0;
    font-size: 13px;
    color: var(--ink-faint);
}
.atlas-tools .muted {
    margin-right: 10px;
}
.atlas-control {
    min-width: 42px;
}

/* ------------------------------------------------------------------ Repair panel */

.repair {
    position: absolute;
    left: 50%;
    top: 53%;
    translate: -50% -50%;
    width: 660px;
    max-width: 90%;
    padding: 24px 32px 22px;
    background-color: rgba(6, 8, 7, .86);
    border-width: 1px;
    border-color: var(--hairline);
    border-top-width: 2px;
    border-top-color: var(--brass);
    transition-property: opacity, translate;
    transition-duration: .25s;
    transition-timing-function: ease-out;
}
.repair.entrance {
    translate: -50% -46%;
}
.repair-heading {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}
.repair-overline {
    margin: 0;
    font-size: 12px;
    letter-spacing: 7px;
    color: var(--brass);
}
.repair-step {
    margin: 0;
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--ink-faint);
}
.repair-title {
    margin: 10px 0 0;
    font-size: 32px;
    letter-spacing: 7px;
    color: var(--ink-bright);
}
.repair-detail {
    margin: 10px 0 20px;
    font-size: 17px;
    color: var(--ink-soft);
    white-space: normal;
}
.repair-options {
    flex-direction: row;
    margin-bottom: 20px;
}
.repair-option {
    flex-grow: 1;
    flex-basis: 0;
    height: 96px;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
    background-color: rgba(236, 229, 211, .04);
    border-width: 1px;
    border-color: rgba(236, 229, 211, .16);
    border-radius: 3px;
    transition-property: background-color, border-color, scale;
    transition-duration: .14s;
}
.repair-option--selected {
    scale: 1.04 1.04;
    background-color: rgba(202, 164, 107, .17);
    border-color: var(--brass-bright);
}
.repair-option-text {
    margin: 0;
    font-size: 34px;
    letter-spacing: 3px;
    color: var(--ink-soft);
}
.repair-option--selected .repair-option-text {
    color: var(--brass-bright);
}
.repair-keys {
    flex-direction: row;
    justify-content: flex-end;
}

/* ------------------------------------------------------------------ Narrow windows */

.compact .menu-column {
    left: 5%;
    width: 90%;
}
.compact .menu-heading {
    font-size: 52px;
}
.compact .pause-brief {
    display: none;
}
.compact .sheet {
    width: 100%;
    padding: 20px 22px;
}
.compact .inventory-workspace {
    width: 94%;
}
.compact .inventory-item {
    width: 112px;
    height: 132px;
}
.compact .inventory-heading, .compact .atlas-heading {
    font-size: 38px;
}
.compact .floor-rail {
    width: 88px;
}
.compact .control-row {
    width: 100%;
}

/* Night dispatch shares the copper and enamel used by the mechanical dial. */
.station-strip {
    position: absolute;
    left: 50%; top: 26px; translate: -50% 0;
    flex-direction: row;
    padding: 5px 7px 8px;
    background-color: rgba(12,16,15,.78);
}
.station-channel { width: 117px; margin: 0 5px; }
.station-name { font-size: 14px; letter-spacing: 1px; color: #d9cbb4; margin: 0 0 4px; }
.station-live { color: #a8ddba; }
.station-selected { color: #ffdb97; -unity-font-style: bold; }
.station-track { height: 6px; background-color: #484840; overflow: hidden; }
.station-fill { height: 100%; background-color: #dcaf67; }
.dispatch-heading { margin: 0 0 4px; color: #e7c792; font-size: 20px; letter-spacing: 2px; }
.dispatch-line { margin: 2px 0; color: #ede4d4; font-size: 16px; white-space: normal; }
.field-instrument {
    position: absolute; left: 50%; bottom: 20%; translate: -50% 0;
    width: 310px; padding: 13px 18px; background-color: rgba(15,21,19,.93);
    border-top-width: 1px; border-top-color: #b99a68;
}
.field-instrument .station-track { margin: 4px 0 8px; }
.instrument-reading { font-size: 20px; color: #f5dfb4; }
.compact .station-channel { width: 82px; margin: 0 2px; }
.compact .station-name { font-size: 12px; }
.compact .station-strip { top: 8px; }

/* The receiver is the player's single active lead. The full docket lives on the map. */
.play-hud .objective { left: 3.4%; top: 36%; max-width: 32%; }
.play-hud .objective-tag { font-size: 16px; letter-spacing: 2px; text-shadow: 0 1px 5px #080907; }
.field-call-sign { width: 21px; height: 20px; margin-right: 7px; }
.play-hud .objective-text { font-size: 27px; -unity-font-style: bold; letter-spacing: 1px; }
.play-hud .objective-place { font-size: 17px; color: #d0c7b5; letter-spacing: 1px; margin-top: 4px; }
.field-danger { position: absolute; left: 3.4%; top: 22%; }
/* A dispatch sheet carried inside the folded bathhouse map. */
.dispatch-board {
    width: 90%; height: 86%; max-width: 1020px; max-height: 680px;
    padding: 70px 62px 45px;
    background-image: url("DispatchBoard.jpg");
    -unity-background-scale-mode: stretch-to-fill;
}
.dispatch-board .atlas-header { border-bottom-color: #58513d; padding-bottom: 8px; }
.dispatch-board .atlas-heading { color: #332f25; font-size: 44px; letter-spacing: 6px; text-shadow: 0 0 0 rgba(0,0,0,0); }
.dispatch-board .overline { color: #514334; font-size: 16px; letter-spacing: 2px; }
.dispatch-board .chip-button { color: #3e3527; border-color: #7e7159; background-color: rgba(0,0,0,0); }
.dispatch-board .chip-button:hover, .dispatch-board .chip-button:focus { color: #f3e1bd; background-color: #514637; }
.order-book { flex-grow: 1; min-height: 0; margin-top: 9px; }
.order-entry {
    flex-direction: row; align-items: center; justify-content: space-between;
    padding: 8px 10px 9px 14px; margin: 0; min-height: 71px;
    background-color: rgba(0,0,0,0); border-width: 0; border-radius: 0;
    border-bottom-width: 1px; border-bottom-color: rgba(64,54,38,.43);
}
.order-entry:hover, .order-entry:focus { background-color: rgba(90,64,35,.13); }
.order-entry--tracked { border-left-width: 3px; border-left-color: #75392a; }
.order-entry:disabled { opacity: .74; }
.order-copy { flex-shrink: 1; flex-grow: 1; margin-right: 14px; align-items: flex-start; }
.order-name { -unity-text-align: middle-left; font-size: 24px; margin: 0; color: #332e25; }
.order-note { -unity-text-align: middle-left; white-space: normal; font-size: 17px; margin: 2px 0 0; color: #4a4234; }
.order-stamp { font-size: 17px; color: #544938; padding: 2px 7px; }
.order-entry--tracked .order-stamp { color: #75392a; border-width: 1px; border-color: #854834; rotate: -4deg; }
.compact .dispatch-board { padding: 48px 32px 28px; }
.compact .play-hud .objective { max-width: 43%; }
.compact .play-hud .objective-text { font-size: 22px; }

/* Dark glass, brass fiducials and an unlabelled centre leave the subject in view. */
.survey-finder { background-color: rgba(24,29,26,.08); }
.finder-frame { position: absolute; left: 25%; right: 25%; top: 24%; bottom: 24%; }
.finder-corner { position: absolute; width: 30px; height: 24px; border-color: #dddacc; }
.finder-ready .finder-corner { border-color: #efbf75; }
.tl { left: 0; top: 0; border-left-width: 2px; border-top-width: 2px; }
.tr { right: 0; top: 0; border-right-width: 2px; border-top-width: 2px; }
.bl { left: 0; bottom: 0; border-left-width: 2px; border-bottom-width: 2px; }
.br { right: 0; bottom: 0; border-right-width: 2px; border-bottom-width: 2px; }
.finder-pin { position: absolute; width: 19px; height: 19px; translate: -50% -50%;
    border-width: 1px; border-radius: 11px; border-color: #e4d8c4; }
.pin-ready { border-width: 2px; border-color: #ffd18b; }
.finder-legend { position: absolute; top: 11%; align-self: center; align-items: center; }
.finder-subject { margin: 0; font-size: 24px; color: #f4d498; letter-spacing: 2px; text-shadow: 0 1px 5px #0a0806; }
.finder-hint { font-size: 18px; margin: 5px; color: #f4ebda; text-shadow: 0 1px 4px #080706; }
.shutter-glint { background-color: rgba(235,217,179,.25); }
.contact-table { position: absolute; align-self: center; top: 18%; width: 45%; height: 56%; align-items: center; }
.contact-mount { width: 100%; height: 94%; padding: 12px 12px 4px; background-color: #cabea6; rotate: -1deg; }
.contact-image { flex-grow: 1; background-color: #181815; -unity-background-scale-mode: scale-to-fit; }
.contact-caption { font-size: 19px; color: #40362d; padding: 6px 5px; }
.river-weirs { position: absolute; right: 6%; bottom: 16%; width: 370px; padding: 14px 16px;
    background-color: rgba(16,23,21,.92); border-left-width: 2px; border-left-color: #bba77d; }
.weir-bank { flex-direction: row; margin: 8px 0; }
.weir-valve { flex-grow: 1; font-size: 20px; color: #b0ada1; padding: 5px; border-bottom-width: 2px; border-bottom-color: #4b4e46; }
.valve-open { color: #b2d0b3; }
.valve-selected { border-bottom-color: #e9b76a; }

.splice-glass { width: 100%; height: 94%; background-color: #b5aa8c; overflow: hidden; border-width: 6px; border-color: #403f36; }
.splice-strip { position: absolute; width: 33.333%; height: 76%; }
.splice-active { border-bottom-width: 4px; border-bottom-color: #f6c074; }

.sounding-desk { position: absolute; align-self: center; top: 17%; width: 600px; height: 400px;
    background-image: resource("Interface/SoundingDesk"); -unity-background-scale-mode: stretch-to-fill; }
.sounding-raster { position: absolute; left: 8%; right: 8%; top: 15%; bottom: 22%; overflow: hidden; }
.sounding-label { position: absolute; top: 14%; left: 10%; color: #b4d6b4; font-size: 16px; background-color: rgba(9,23,14,.84); padding: 2px 5px; }
.sounding-keys { position: absolute; top: 100%; align-self: center; color: #e5dcbe; }
.compact .sounding-desk { top: 14%; width: 390px; height: 260px; }

.ticket-tab {
    position: absolute; top: 34px; right: 42px; padding: 7px 18px;
    min-height: 42px; font-size: 21px; color: rgb(232,216,177);
    background-color: rgba(20,23,21,.92); border-width: 0; border-bottom-width: 2px;
    border-bottom-color: rgb(154,126,75); -unity-text-align: middle-center;
}
.ticket-tab:hover, .ticket-tab:focus { background-color: rgb(54,51,39); color: rgb(255,241,210); }
.ticket-wallet {
    position: absolute; right: 42px; top: 89px; width: 490px; max-width: 86%; max-height: 77%;
    background-color: rgb(196,179,146); background-image: url("TicketWallet.jpg");
    background-size: 100% 100%;
    padding: 18px 22px 20px 35px; transition-property: opacity, translate; transition-duration: .2s;
}
.ticket-wallet.entrance { opacity: 0; translate: 0 -10px; }
.ticket-head, .ticket-stub {flex-direction: row; justify-content: space-between; align-items: center;}
.ticket-head {margin-bottom: 10px;}
.ticket-caption {font-size: 24px; color: rgb(45,43,36);}
.ticket-count {font-size: 16px; color: rgb(82,67,47);}
.ticket-scroll {flex-shrink: 1; min-height: 50px;}
.ticket-stub {padding: 9px 4px; border-top-width: 1px; border-top-color: rgb(139,122,93); min-height: 71px;}
.ticket-copy {flex-grow: 1; flex-shrink: 1;}
.ticket-name {font-size: 23px; color: rgb(42,42,34);}
.ticket-line {font-size: 15px; color: rgb(71,65,50); white-space: normal; margin-top: 2px;}
.ticket-ink {font-size: 14px; color: rgb(80,72,53); margin-left: 8px;}
.ticket-ink--used {color: rgb(115,48,34); border-width: 1px; border-color: rgb(135,60,42); padding: 1px 5px; rotate: -5deg;}
.compact .ticket-tab, .compact .ticket-wallet {right: 14px;}

.return-proof {align-self: center; align-items: center; margin: 9px 0; padding: 8px 30px;
    background-color: rgb(200,186,152); background-image: url("TicketWallet.jpg"); background-size: 100% 100%; rotate: -2deg; border-left-color: rgb(114,73,54); border-left-width: 5px;}
.proof-mark {font-size: 20px; color: rgb(41,49,42);}
.proof-sign {font-size: 15px; color: rgb(94,49,36);}

/* Green linoleum belongs to the duty desk; ink on paper belongs to the objects laid on it. */
.desk-surface, .survey-plan, .sheet {
    background-image: url("NightDesk.jpg"); background-size: cover;
    -unity-background-image-tint-color: rgb(161,174,164);
}
.inventory-workspace { width: 89%; }
.inventory-work { margin-top: 7px; }
.inventory-library { width: 43%; }
.item-inspection { width: 57%; border-left-width: 0; padding: 12px 2% 0 3%; }
.inventory-item { background-color: rgba(13,20,16,.53); border-radius: 1px; }
.inventory-item--selected { border-bottom-width: 3px; border-bottom-color: #d8b078; }
.inventory-tab { color: #bcb8a5; }
.inventory-tab--active { color: #fff2d7; }
.evidence-index { flex-direction: column; flex-wrap: nowrap; align-content: stretch; }
.evidence-index .inventory-item {
    width: 100%; min-height: 62px; height: auto; flex-shrink: 0; margin: 0;
    padding: 8px 16px; border-width: 0; border-left-width: 2px; border-bottom-width: 1px;
    border-color: rgba(188,185,151,.28); background-color: rgba(4,8,6,.12); border-radius: 0;
}
.evidence-index .inventory-item:hover, .evidence-index .inventory-item:focus { translate: 0 0; background-color: rgba(200,184,142,.12); border-left-color: #f4d09a; }
.evidence-index .inventory-item--selected { background-color: rgba(219,188,130,.16); border-left-color: #edc486; }
.evidence-entry { align-items: flex-start; }
.entry-title { margin: 0; color: #efe8d6; font-size: 22px; }
.entry-source { margin: 2px 0 0; color: #c1bba8; font-size: 14px; }
.evidence-table { flex-grow: 1; min-height: 0; justify-content: center; align-items: center; }
.evidence-photo, .evidence-paper { width: 91%; transition-property: opacity, translate, rotate; transition-duration: .22s; }
.evidence-photo.entrance, .evidence-paper.entrance { rotate: 1deg; }
.evidence-photo { height: 70%; max-height: 415px; padding: 9px 9px 6px; rotate: -2deg; background-color: #dcd0b9; }
.evidence-emulsion { flex-grow: 1; background-size: contain; background-repeat: no-repeat; background-position: center; }
.photo-pencil { font-size: 18px; margin-top: 4px; color: #443e31; -unity-text-align: middle-center; }
.evidence-paper {
    height: 64%; max-height: 350px; padding: 26px 32px 24px 38px;
    background-color: #c7b799; background-image: url("TicketWallet.jpg");
    background-size: 100% 100%; rotate: -0.6deg;
}
.paper-scroll { flex-grow: 1; min-height: 0; }
.paper-origin { margin: 0; color: #744a33; font-size: 16px; }
.paper-title { font-size: 28px; color: #39382e; white-space: normal; margin-top: 9px; }
.paper-rule { margin: 12px 0 14px; height: 1px; background-color: rgba(75,62,44,.52); }
.paper-writing { color: #343129; font-size: 22px; white-space: normal; margin: 0; }
.print-turn { margin-top: 14px; align-self: center; }
.evidence-link { color: #edd09a; font-size: 16px; margin-top: 12px; padding: 3px 8px; background-color: rgba(0,0,0,0); border-width: 0; border-bottom-width: 1px; border-bottom-color: #b59f76; }
.evidence-link:hover, .evidence-link:focus { background-color: #454939; }
.instrument-tabs { flex-direction: row; margin: 4px 0 12px; }
.instrument-tab { padding: 6px 18px; margin: 0 8px 0 0; color: #cbc8ba; font-size: 18px; border-width: 0; border-radius: 0; border-bottom-width: 2px; border-bottom-color: #5c6252; background-color: rgba(15,22,17,.70); }
.instrument-tab:hover, .instrument-tab:focus { color: #fff4dc; background-color: #505342; }
.instrument-tab--selected { color: #ffebbd; border-bottom-color: #e5b778; background-color: #3a4034; }
.instrument-page { padding: 4px 0 10px; }
.setting-row, .switch-row { min-height: 46px; }
.survey-plan { padding: 23px 30px 19px; background-color: #203029; }
.survey-plan .map-drawing { background-color: rgba(21,50,54,.69); border-color: #7f8774; }
.survey-plan .floor-tab { color: #bdbeb0; }
.survey-plan .floor-tab--selected { color: #ffe2ab; }
.survey-plan .legend-text, .survey-plan .muted { color: #d0d0c1; }
.ending-veil { align-items: flex-start; }
.ending { align-items: flex-start; margin-left: 8%; max-width: 68%; }
.ending-scrim { background-size: 100% 100%; }
.ending-caption { white-space: normal; max-width: 680px; margin-bottom: 8px; color: #e4decc; }
.ending-title, .ending-overline { padding-left: 0; }
.ending-actions .menu-item { margin: 0 18px 0 0; }
.ending .return-proof { align-self: flex-start; }
.compact .survey-plan { padding: 12px; }
.compact .evidence-paper { width: 98%; padding: 16px 18px 14px 24px; }
.compact .evidence-photo { width: 98%; }
.compact .ending { max-width: 85%; }
.compact .ending-title { font-size: 64px; letter-spacing: 7px; }

.plan-north { position: absolute; top: 12px; right: 17px; margin: 0; padding: 3px 5px;
    color: #d5c9a9; font-size: 16px; background-color: #182d2d; }

.watch-station {
    position: absolute;
    top: 5%;
    right: 3%;
    width: 304px;
    padding: 15px;
    background-color: rgba(9, 16, 16, .92);
    border-left-width: 2px;
    border-left-color: #b49869;
}
.watch-view .watch-chart { height: 238px; margin-top: 10px; overflow: hidden; background-color: #101918; }
.watch-station .watch-intent { font-size: 28px; color: #edddba; }
.watch-station .watch-place, .watch-station .watch-goal { font-size: 17px; color: #dfdacb; }
.watch-station .watch-legend, .watch-controls { flex-direction: row; align-items: center; }
.watch-legend > Label { font-size: 16px; margin: 6px 13px 7px 0; }
.watch-station .watch-footprints { color: #61e0d3; }
.watch-station .watch-plan { color: #f9c775; }
.watch-kicker, .watch-help { font-size: 15px; color: #c2b79e; }
.watch-controls { position: absolute; bottom: 5%; left: 3%; background-color: rgba(8, 13, 13, .9); padding: 6px 10px; }
.watch-controls > Button { margin-left: 8px; }
.compact .watch-station { width: 248px; }
.compact .watch-chart { height: 185px; }
