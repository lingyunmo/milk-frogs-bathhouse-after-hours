
/* After Hours interface, part one: tokens, title screen and the in-play HUD.
   Text floats over the world with soft shade instead of boxed panels. Brass marks what matters now. */
:root {
    --ink: #ece5d3;
    --ink-bright: #f4eddc;
    --ink-soft: rgba(236, 229, 211, .80);
    --ink-faint: rgba(236, 229, 211, .54);
    --hairline: rgba(236, 229, 211, .15);
    --brass: #caa46b;
    --brass-bright: #f0d39f;
    --brass-soft: rgba(202, 164, 107, .38);
    --blood: #d75a41;
    --night: #050706;
}
.after-hours {
    flex-grow: 1;
    color: var(--ink);
    font-size: 17px;
}
.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.entrance {
    opacity: 0;
    translate: 0 10px;
}

/* ------------------------------------------------------------------ Keycaps and small type */

.key {
    margin: 0;
    min-width: 24px;
    height: 24px;
    padding: 0 7px;
    font-size: 12px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--ink);
    border-width: 1px;
    border-bottom-width: 2px;
    border-color: rgba(236, 229, 211, .34);
    border-bottom-color: rgba(236, 229, 211, .20);
    border-radius: 4px;
    background-color: rgba(10, 13, 12, .74);
}
.key-join {
    margin: 0 4px;
    font-size: 12px;
    color: var(--ink-faint);
    -unity-text-align: middle-center;
}
.key-hints {
    flex-direction: row;
    align-items: center;
}
.key-hint {
    flex-direction: row;
    align-items: center;
    margin-left: 22px;
}
.key-hint-text {
    margin: 0 0 0 7px;
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--ink-faint);
}
.overline {
    margin: 0 0 6px;
    font-size: 13px;
    letter-spacing: 4px;
    color: var(--brass);
}
.muted {
    margin: 0;
    font-size: 13px;
    color: var(--ink-faint);
}

/* ------------------------------------------------------------------ Title */

.theater {
    background-color: var(--night);
    overflow: hidden;
}
.title-backdrop {
    position: absolute;
    width: 100%;
    height: 100%;
    background-size: 100% 100%;
    transform-origin: 71% 53%;
}
.title-haze {
    left: 32%;
    right: 0;
    top: 10%;
    bottom: 8%;
    background-repeat: repeat-x;
    background-size: 1024px 100%;
    -unity-background-image-tint-color: rgba(170, 192, 181, .52);
    opacity: .3;
}
.title-lamp, .title-lamp-shade, .title-lamp-core, .title-corner-light {
    position: absolute;
    translate: -50% -50%;
    background-size: 100% 100%;
    opacity: 0;
}
.title-lamp, .title-lamp-shade, .title-lamp-core {
    left: 55.6%;
    top: 13%;
}
.title-lamp {
    width: 23%;
    height: 37%;
    -unity-background-image-tint-color: rgba(255, 184, 96, .56);
}
.title-lamp-shade {
    width: 47%;
    height: 97%;
    -unity-background-image-tint-color: rgba(3, 6, 6, .98);
}
.title-lamp-core {
    width: 6.2%;
    height: 15%;
    -unity-background-image-tint-color: rgba(255, 218, 149, .94);
}
.title-lamp-sparks {
    position: absolute;
    left: 55.6%;
    top: 15.2%;
    width: 24%;
    height: 46%;
    translate: -50% -22%;
}
.title-corner-light {
    left: 82%;
    top: 43%;
    width: 40%;
    height: 86%;
    -unity-background-image-tint-color: rgba(125, 168, 146, .56);
}
.title-corner {
    position: absolute;
    left: 63%;
    right: 10.6%;
    top: 9%;
    bottom: 16%;
    overflow: hidden;
}
.title-hall-frog {
    position: absolute;
    top: 3%;
    width: 147%;
    height: 99%;
    scale: -1 1;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
}
.title-blackout {
    background-color: #020504;
    opacity: 0;
}
.title-intruder {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 64%;
    height: 87%;
    rotate: 180deg;
    opacity: 0;
}
.title-scrim-left {
    right: 42%;
    background-size: 100% 100%;
}
.title-scrim-bottom {
    top: 62%;
    background-size: 100% 100%;
}
.title-vignette, .ending-vignette {
    background-size: 100% 100%;
}
.film-grain {
    background-repeat: repeat;
    background-size: 192px 192px;
    opacity: .34;
}
.title-block {
    position: absolute;
    left: 7.2%;
    top: 16%;
    align-items: flex-start;
}
.title-block--resume {
    top: 13%;
}
.title-block > *, .title-menu > *, .ending > * {
    transition-property: opacity, translate;
    transition-duration: .9s;
    transition-timing-function: ease-out;
}
.title-overline {
    margin: 0 0 20px 5px;
    font-size: 13px;
    letter-spacing: 8px;
    color: var(--brass);
}
.title-brand {
    margin: 0 0 0 3px;
    font-size: 30px;
    letter-spacing: 19px;
    color: rgba(236, 229, 211, .88);
    text-shadow: 0 2px 10px rgba(0, 0, 0, .8);
}
.title-name {
    margin: -6px 0 0 -12px;
    font-size: 158px;
    letter-spacing: 6px;
    color: var(--ink-bright);
    text-shadow: 0 8px 28px rgba(0, 0, 0, .75);
}
.title-chapter-row {
    flex-direction: row;
    align-items: center;
    margin: 6px 0 0 5px;
}
.title-chapter-rule {
    width: 56px;
    height: 1px;
    background-color: var(--brass-soft);
}
.title-chapter {
    margin: 0 14px 0 18px;
    font-size: 19px;
    letter-spacing: 13px;
    color: var(--brass-bright);
}
.title-menu {
    position: absolute;
    left: 7.2%;
    bottom: 16%;
    align-items: flex-start;
}
.title-footer {
    position: absolute;
    left: 7.2%;
    right: 5%;
    bottom: 5%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}
.title-edition {
    margin: 0;
    font-size: 12px;
    letter-spacing: 6px;
    color: var(--ink-faint);
}
.title-sheet {
    position: absolute;
    left: 42%;
    top: 13%;
    max-height: 76%;
    width: 660px;
}

/* Menu entries shared by the title, pause and ending screens. */
.menu-item {
    margin: 0 0 4px;
    padding: 0;
    height: 48px;
    min-width: 280px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    font-size: 26px;
    letter-spacing: 5px;
    color: var(--ink-soft);
    -unity-text-align: middle-left;
    -unity-font-style: normal;
    text-shadow: 0 2px 10px rgba(0, 0, 0, .9);
    transition-property: padding-left, color, border-left-color, background-color;
    transition-duration: .2s;
    transition-timing-function: ease-out;
}
.menu-item:hover, .menu-item:focus {
    padding-left: 20px;
    color: #fff6e2;
    border-left-color: var(--brass);
    background-color: rgba(202, 164, 107, .07);
}
.menu-item:active {
    color: var(--brass-bright);
}
.menu-item--primary {
    color: var(--brass-bright);
}

/* ------------------------------------------------------------------ Play HUD */

.corner-shade {
    position: absolute;
    background-size: 100% 100%;
    opacity: .72;
}
.corner-shade--top-left {
    left: -300px;
    top: -230px;
    width: 980px;
    height: 500px;
}
.corner-shade--bottom-left {
    left: -280px;
    bottom: -260px;
    width: 940px;
    height: 500px;
}
.objective {
    position: absolute;
    left: 52px;
    top: 44px;
    max-width: 44%;
    transition-property: opacity;
    transition-duration: 1.2s;
}
.objective--quiet {
    opacity: .64;
}
.objective-tagline {
    flex-direction: row;
    align-items: center;
    margin-bottom: 7px;
}
.objective-diamond {
    width: 7px;
    height: 7px;
    margin-right: 11px;
    rotate: 45deg;
    background-color: var(--brass);
    transition-property: background-color, scale;
    transition-duration: .3s;
}
.objective-tag {
    margin: 0;
    font-size: 12px;
    letter-spacing: 6px;
    color: var(--brass);
    transition-property: color;
    transition-duration: .3s;
}
.objective--updated .objective-tag {
    color: var(--brass-bright);
}
.objective--updated .objective-diamond {
    scale: 1.5 1.5;
    background-color: var(--brass-bright);
}
.objective-text {
    margin: 0;
    font-size: 26px;
    letter-spacing: 2px;
    color: var(--ink-bright);
    white-space: normal;
    text-shadow: 0 2px 12px rgba(0, 0, 0, .95);
}
.objective-place {
    margin: 8px 0 0;
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--ink-faint);
    text-shadow: 0 1px 5px rgba(0, 0, 0, 1);
}
.danger {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
}
.danger-dot {
    width: 7px;
    height: 7px;
    margin-right: 10px;
    border-radius: 4px;
    background-color: var(--blood);
}
.danger-text {
    margin: 0;
    font-size: 14px;
    letter-spacing: 5px;
    color: #f19580;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 1);
}

.minimap {
    position: absolute;
    right: 52px;
    top: 40px;
    width: 176px;
    align-items: center;
}
.minimap-ring {
    width: 176px;
    height: 176px;
    border-radius: 88px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(236, 229, 211, .30);
    background-color: rgba(6, 9, 8, .62);
}
.minimap-drawing {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.minimap-glass {
    border-radius: 88px;
    border-width: 7px;
    border-color: rgba(3, 5, 4, .42);
}
.minimap-north {
    position: absolute;
    width: 18px;
    height: 18px;
    margin: 0;
    padding: 0;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--brass-bright);
    background-color: rgba(6, 9, 8, .94);
    border-width: 1px;
    border-color: var(--brass-soft);
    border-radius: 9px;
}
.minimap-caption {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
}
.map-floor {
    margin: 0 9px 0 0;
    font-size: 15px;
    letter-spacing: 3px;
    color: var(--brass-bright);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 1);
}
.map-place {
    margin: 0 10px 0 0;
    font-size: 14px;
    color: var(--ink-soft);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 1);
}

.area-card {
    position: absolute;
    left: 50%;
    top: 14%;
    translate: -50% 0;
    align-items: center;
    opacity: 0;
    transition-property: opacity, translate;
    transition-duration: 1.1s;
    transition-timing-function: ease-in-out;
}
.area-card--shown {
    opacity: 1;
    translate: -50% 8px;
}
.area-floor-row {
    flex-direction: row;
    align-items: center;
}
.area-rule {
    width: 48px;
    height: 1px;
    background-color: var(--brass-soft);
}
.area-floor {
    margin: 0 14px;
    padding-left: 7px;
    font-size: 13px;
    letter-spacing: 7px;
    color: var(--brass);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 1);
}
.area-name {
    margin: 8px 0 0;
    padding-left: 15px;
    font-size: 44px;
    letter-spacing: 15px;
    color: var(--ink-bright);
    text-shadow: 0 3px 20px rgba(0, 0, 0, 1);
}

.reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 44px;
    height: 44px;
    translate: -50% -50%;
}
.prompt {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: 32px -50%;
    flex-direction: row;
    align-items: center;
}
.prompt-key {
    margin-right: 11px;
}
.prompt-text {
    margin: 0;
    font-size: 18px;
    letter-spacing: 1px;
    color: var(--ink-bright);
    text-shadow: 0 1px 9px rgba(0, 0, 0, 1);
}
.prompt-hold {
    margin: 0 0 0 12px;
    font-size: 12px;
    letter-spacing: 4px;
    color: var(--brass);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 1);
}

.subtitle-shade {
    position: absolute;
    left: 50%;
    bottom: 13%;
    translate: -50% 0;
    max-width: 72%;
    padding: 30px 110px;
    background-size: 100% 100%;
    transition-property: opacity, translate;
    transition-duration: .28s;
}
.subtitle-shade.entrance {
    translate: -50% 8px;
}
.subtitle {
    margin: 0;
    font-size: 19px;
    letter-spacing: 1px;
    color: #f2e8d1;
    white-space: normal;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 7px rgba(0, 0, 0, 1);
}

.pickup {
    position: absolute;
    right: 52px;
    bottom: 168px;
    flex-direction: row;
    align-items: center;
    padding: 12px 22px 12px 12px;
    background-color: rgba(7, 9, 8, .70);
    border-left-width: 2px;
    border-left-color: var(--brass);
    opacity: 0;
    translate: 46px 0;
    transition-property: opacity, translate;
    transition-duration: .5s;
    transition-timing-function: ease-out;
}
.pickup--shown {
    opacity: 1;
    translate: 0 0;
}
.pickup-art {
    width: 66px;
    height: 54px;
    margin-right: 15px;
    background-size: contain;
    background-position: center;
}
.pickup-tag {
    margin: 0;
    font-size: 11px;
    letter-spacing: 6px;
    color: var(--brass);
}
.pickup-text {
    margin: 4px 0 0;
    font-size: 19px;
    letter-spacing: 1px;
    color: var(--ink-bright);
}

.stamina {
    position: absolute;
    left: 50%;
    bottom: 52px;
    translate: -50% 0;
    width: 320px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: .7s;
}
.stamina--shown {
    opacity: 1;
}
.stamina-track {
    height: 3px;
    overflow: hidden;
    background-color: rgba(236, 229, 211, .15);
}
.meter-fill {
    height: 100%;
    width: 0;
}
.stamina-fill {
    background-color: rgba(240, 233, 216, .86);
    transition-property: width, background-color;
    transition-duration: .12s;
    transition-timing-function: ease-out;
}
.stamina-track .meter-fill--low {
    background-color: var(--blood);
}

.equipment {
    position: absolute;
    left: 52px;
    bottom: 44px;
    flex-direction: row;
    align-items: flex-end;
}
.slot {
    flex-direction: row;
    align-items: center;
    margin-right: 26px;
}
.slot-art {
    width: 44px;
    height: 38px;
    margin-right: 9px;
    background-size: contain;
    background-position: center;
}
.slot-top {
    flex-direction: row;
    align-items: center;
}
.slot-value {
    margin: 0 9px 0 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--ink-bright);
    text-shadow: 0 1px 7px rgba(0, 0, 0, 1);
}
.slot-name {
    margin: 4px 0 0;
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--ink-faint);
    text-shadow: 0 1px 5px rgba(0, 0, 0, 1);
}
.torch-slot .slot-art {
    width: 58px;
    height: 48px;
}
.torch-slot .slot-value {
    min-width: 52px;
    font-size: 22px;
}
.torch-track {
    width: 92px;
    height: 5px;
    margin-top: 7px;
    background-color: rgba(236, 229, 211, .16);
}
.torch-fill {
    background-color: rgba(236, 229, 211, .70);
    transition-property: width, background-color;
    transition-duration: .2s;
}
.torch-slot--lit .torch-fill {
    background-color: var(--brass-bright);
}
.torch-slot--lit .slot-value {
    color: var(--brass-bright);
}
.torch-slot--low .slot-value, .torch-track .meter-fill--low {
    color: #f19580;
    background-color: var(--blood);
}

.hint-row {
    position: absolute;
    left: 50%;
    bottom: 18px;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    opacity: .62;
}
.hotkey {
    flex-direction: row;
    align-items: center;
    margin: 0 9px;
}
.hotkey-name {
    margin: 0 0 0 7px;
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--ink-faint);
    text-shadow: 0 1px 5px rgba(0, 0, 0, 1);
}
.hotkey--active .key {
    color: var(--brass-bright);
    border-color: var(--brass);
}
.hotkey--active .hotkey-name {
    color: var(--brass-bright);
}

.curtain {
    background-color: #000;
}
.chapter {
    position: absolute;
    left: 50%;
    top: 47%;
    align-items: center;
}
.chapter-overline {
    margin: 0;
    padding-left: 13px;
    font-size: 15px;
    letter-spacing: 13px;
    color: var(--brass);
}
.chapter-rule {
    width: 84px;
    height: 1px;
    margin: 18px 0;
    background-color: var(--brass-soft);
}
.chapter-title {
    margin: 0;
    padding-left: 20px;
    font-size: 66px;
    letter-spacing: 20px;
    color: var(--ink-bright);
}

.letterbox.entrance {
    opacity: 1;
    translate: 0 0;
}
.letterbox-bar {
    position: absolute;
    left: 0;
    right: 0;
    height: 11%;
    background-color: #000;
    transition-property: height;
    transition-duration: .8s;
    transition-timing-function: ease-out;
}
.letterbox.entrance .letterbox-bar {
    height: 0;
}
.letterbox-bar--top {
    top: 0;
}
.letterbox-bar--bottom {
    bottom: 0;
}

/* ------------------------------------------------------------------ Narrow windows */

.compact .title-name {
    font-size: 104px;
}
.compact .title-block {
    top: 10%;
}
.compact .title-intruder {
    width: 66%;
    height: 77%;
}
.compact .title-brand {
    font-size: 24px;
    letter-spacing: 12px;
}
.compact .menu-item {
    height: 40px;
    font-size: 21px;
}
.compact .title-sheet {
    left: 5%;
    width: 90%;
}
.compact .objective {
    left: 22px;
    top: 20px;
    max-width: 52%;
}
.compact .objective-text {
    font-size: 20px;
}
.compact .minimap {
    right: 22px;
    top: 18px;
    width: 124px;
}
.compact .minimap-ring {
    width: 124px;
    height: 124px;
    border-radius: 62px;
}
.compact .minimap-glass {
    border-radius: 62px;
}
.compact .equipment {
    left: 22px;
    bottom: 20px;
}
.compact .slot {
    margin-right: 14px;
}
.compact .slot-name, .compact .hint-row, .compact .map-place {
    display: none;
}
.compact .pickup {
    right: 22px;
    bottom: 104px;
}
.compact .stamina {
    bottom: 96px;
    width: 48%;
}
.compact .area-name {
    font-size: 32px;
}
