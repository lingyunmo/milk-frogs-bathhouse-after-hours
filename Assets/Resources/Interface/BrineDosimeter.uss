.radiation-unit {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    margin-top: 9px;
    padding: 2px 10px 2px 2px;
    background-color: rgba(17, 24, 22, 0.88);
    border-left-width: 2px;
    border-left-color: rgb(158, 161, 135);
}
.radiation-dial { width: 86px; height: 40px; }
.radiation-copy { margin-left: 9px; }
.radiation-reading { font-size: 15px; color: rgb(224, 221, 191); }
.radiation-dose { flex-direction: row; align-items: center; }
.radiation-caption { color: rgb(181, 191, 172); font-size: 12px; margin-right: 5px; }
.radiation-strip { width: 64px; height: 5px; background-color: rgb(56, 64, 58); }
.radiation-fill { height: 100%; background-color: rgb(206, 182, 122); }
.radiation-unit--high { border-left-color: rgb(226, 124, 80); }
.radiation-unit--high .radiation-reading, .radiation-unit--high .radiation-caption { color: rgb(248, 175, 118); }
.radiation-unit--high .radiation-fill { background-color: rgb(236, 130, 81); }
